<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nammy_bringup</name>
  <version>1.0.0</version>
  <description>Master Launch and Orchestration Bringup for Nammy Robot Platform</description>
  <maintainer email="namanharshwal@gmail.com">Naman Harshwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>nammy_description</exec_depend>
  <exec_depend>nammy_base</exec_depend>
  <exec_depend>nammy_motors</exec_depend>
  <exec_depend>nammy_imu</exec_depend>
  <exec_depend>nammy_power</exec_depend>
  <exec_depend>nammy_display</exec_depend>
  <exec_depend>nammy_teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
