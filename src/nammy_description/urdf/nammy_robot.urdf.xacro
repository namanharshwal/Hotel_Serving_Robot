<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nammy_robot">

  <!-- ============================================================================== -->
  <!-- MATERIALS                                                                      -->
  <!-- ============================================================================== -->
  <material name="chassis_silver">
    <color rgba="0.79216 0.81961 0.93333 1.0"/>
  </material>
  <material name="tire_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="lidar_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="imu_blue">
    <color rgba="0.0 0.3 0.8 1.0"/>
  </material>
  <material name="sonar_gold">
    <color rgba="0.9 0.75 0.1 1.0"/>
  </material>
  <material name="display_bezel">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="display_glass">
    <color rgba="0.15 0.35 0.45 0.85"/>
  </material>

  <!-- ============================================================================== -->
  <!-- ROOT BASE FOOTPRINT (Ground Projection)                                        -->
  <!-- ============================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.033293" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- BASE LINK (SolidWorks Main Chassis)                                            -->
  <!-- ============================================================================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.020032 2.5016E-06 0.0072756" rpy="0 0 0"/>
      <mass value="2.8246"/>
      <inertia
        ixx="0.037562" ixy="4.1763E-08" ixz="-3.154E-05"
        iyy="0.041801" iyz="-7.8675E-10"
        izz="0.078777"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/base_link.STL"/>
      </geometry>
      <material name="chassis_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================================== -->
  <!-- RIGHT DRIVE WHEEL (SolidWorks Wheel Model)                                     -->
  <!-- ============================================================================== -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="-0.000153905731059778 5.63981063028685E-06 0.0303744944581952" rpy="0 0 0"/>
      <mass value="0.988406758977507"/>
      <inertia
        ixx="0.00167499249358559" ixy="-1.18463824720553E-08" ixz="2.58035199821348E-07"
        iyy="0.00167501984402528" iyz="-3.04509965905957E-07"
        izz="0.00287892208388263"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/right_wheel.STL"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/right_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="rtwheeljt" type="continuous">
    <origin xyz="-6.6311E-05 -0.1874 0.033293" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 0 1"/>
    <limit effort="15" velocity="25"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- LEFT DRIVE WHEEL (SolidWorks Wheel Model)                                      -->
  <!-- ============================================================================== -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="4.77905427032077E-06 5.63981063064767E-06 -0.0303744944581938" rpy="0 0 0"/>
      <mass value="0.988406758977505"/>
      <inertia
        ixx="0.00167499249358559" ixy="1.18463824762049E-08" ixz="2.58035199828615E-07"
        iyy="0.00167501984402528" iyz="3.04509965898877E-07"
        izz="0.00287892208388262"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/left_wheel.STL"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/left_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ltwheeljt" type="continuous">
    <origin xyz="-6.6311E-05 0.18743 0.033293" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 1"/>
    <limit effort="15" velocity="25"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- FRONT CASTER ASSEMBLY (SolidWorks Castor & Wheel)                              -->
  <!-- ============================================================================== -->
  <link name="front_castor">
    <inertial>
      <origin xyz="-7.19722439490589E-06 -0.000594523126286717 -0.0150007448059787" rpy="0 0 0"/>
      <mass value="0.0154137567568997"/>
      <inertia
        ixx="7.69974453390217E-06" ixy="4.95170233721413E-10" ixz="-2.87438512726075E-10"
        iyy="1.69225134213422E-06" iyz="-2.38173383574039E-13"
        izz="7.74409516442039E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/front_castor.STL"/>
      </geometry>
      <material name="chassis_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/front_castor.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ftcastorjt" type="fixed">
    <origin xyz="0.2235 0 -0.015" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_castor"/>
  </joint>

  <link name="front_wheel">
    <inertial>
      <origin xyz="6.37783459378483E-09 5.21249710061511E-14 -7.8196618697679E-05" rpy="0 0 0"/>
      <mass value="0.0169008319161431"/>
      <inertia
        ixx="2.41636698596104E-06" ixy="-1.44460473203424E-22" ixz="7.25380393817739E-11"
        iyy="2.41636699187733E-06" iyz="3.18358490283343E-21"
        izz="1.52699798902101E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/front_wheel.STL"/>
      </geometry>
      <material name="chassis_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/front_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="ftwheeljt" type="fixed">
    <origin xyz="0 0.00034763 -0.019" rpy="-1.5708 0 0"/>
    <parent link="front_castor"/>
    <child link="front_wheel"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- BACK CASTER ASSEMBLY (SolidWorks Castor & Wheel)                               -->
  <!-- ============================================================================== -->
  <link name="back_castor">
    <inertial>
      <origin xyz="-7.19722439468384E-06 -0.000594523126285051 -0.015000744805979" rpy="0 0 0"/>
      <mass value="0.0154137567568997"/>
      <inertia
        ixx="7.69974453390218E-06" ixy="4.95170233715715E-10" ixz="-2.87438512726142E-10"
        iyy="1.69225134213422E-06" iyz="-2.38173382942366E-13"
        izz="7.74409516442041E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/back_castor.STL"/>
      </geometry>
      <material name="chassis_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/back_castor.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="bkcstrljt" type="fixed">
    <origin xyz="-0.2235 0 -0.015" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_castor"/>
  </joint>

  <link name="back_wheel">
    <inertial>
      <origin xyz="6.37783514889634E-09 5.19584375524573E-14 -7.81966186964578E-05" rpy="0 0 0"/>
      <mass value="0.016900831916143"/>
      <inertia
        ixx="2.41636698596139E-06" ixy="2.02953885683255E-20" ixz="7.25380393796678E-11"
        iyy="2.41636699187766E-06" iyz="3.10903118844173E-21"
        izz="1.52699798901973E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/back_wheel.STL"/>
      </geometry>
      <material name="chassis_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/back_wheel.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="bkwheeljt" type="fixed">
    <origin xyz="0 0.00034763 -0.019" rpy="-1.5708 0 0"/>
    <parent link="back_castor"/>
    <child link="back_wheel"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- BOSCH BNO055 9-DOF IMU SENSOR                                                  -->
  <!-- ============================================================================== -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia
        ixx="0.0001" ixy="0" ixz="0"
        iyy="0.0001" iyz="0"
        izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.015"/>
      </geometry>
      <material name="imu_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- YDLIDAR G2 360-DEGREE 2D LASER SCANNER (SolidWorks Sensor Mesh)               -->
  <!-- ============================================================================== -->
  <link name="laser_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.001" ixy="0" ixz="0"
        iyy="0.001" iyz="0"
        izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/lidar_sensor.STL" scale="1 1 1"/>
      </geometry>
      <material name="lidar_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nammy_description/meshes/lidar_sensor.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.23449 -4.7499E-05 0.11547" rpy="0 0 ${pi}"/>
    <parent link="base_link"/>
    <child link="laser_frame"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- 4-CHANNEL US-100 ULTRASONIC SENSOR ARRAY                                       -->
  <!-- ============================================================================== -->
  <!-- 1. Front Bumper Ultrasonic Sensor -->
  <link name="front_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
      <material name="sonar_gold"/>
    </visual>
    <visual>
      <origin xyz="0.010 -0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <visual>
      <origin xyz="0.010 0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="front_sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_sonar_link"/>
    <origin xyz="0.250 0.0 0.035" rpy="0 0 0"/>
  </joint>

  <!-- 2. Left Flank Ultrasonic Sensor -->
  <link name="left_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
      <material name="sonar_gold"/>
    </visual>
    <visual>
      <origin xyz="0.010 -0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <visual>
      <origin xyz="0.010 0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="left_sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_sonar_link"/>
    <origin xyz="0.0 0.200 0.035" rpy="0 0 ${pi/2}"/>
  </joint>

  <!-- 3. Right Flank Ultrasonic Sensor -->
  <link name="right_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
      <material name="sonar_gold"/>
    </visual>
    <visual>
      <origin xyz="0.010 -0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <visual>
      <origin xyz="0.010 0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="right_sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_sonar_link"/>
    <origin xyz="0.0 -0.200 0.035" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- 4. Rear Bumper Ultrasonic Sensor -->
  <link name="rear_sonar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
      <material name="sonar_gold"/>
    </visual>
    <visual>
      <origin xyz="0.010 -0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <visual>
      <origin xyz="0.010 0.013 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="tire_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.045 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="rear_sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_sonar_link"/>
    <origin xyz="-0.250 0.0 0.035" rpy="0 0 ${pi}"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- 10.1 INCH CAPACITIVE TOUCHSCREEN HMI DISPLAY CONSOLE                            -->
  <!-- ============================================================================== -->
  <link name="touch_display_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.245 0.160 0.015"/>
      </geometry>
      <material name="display_bezel"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <box size="0.217 0.136 0.002"/>
      </geometry>
      <material name="display_glass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.245 0.160 0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="touch_display_joint" type="fixed">
    <parent link="base_link"/>
    <child link="touch_display_link"/>
    <origin xyz="0.05 0.0 0.22" rpy="0 -0.523598 0"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- LOGITECH C270 HD WEBCAM (Front Vision & Perception)                             -->
  <!-- ============================================================================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.070 0.030"/>
      </geometry>
      <material name="display_bezel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.070 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.075"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <!-- ============================================================================== -->
  <!-- GAZEBO PHYSICS & SENSOR CONFIGURATION                                          -->
  <!-- ============================================================================== -->
  <gazebo reference="base_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="front_castor">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="front_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

  <gazebo reference="back_castor">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="back_wheel">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

</robot>
